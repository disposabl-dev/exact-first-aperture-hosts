use takePhotoWithCameraApp, Photo from "@exact/camera"

component ApertureLog
  mutation photo as shape Photo
  derive issue = match failure(photo) { case some(e) => e.code, case none => "" }
  state caption = ""
  action take
    send photo = takePhotoWithCameraApp()
  action edit(value)
    caption = value
  view
    main testId="root" width="100%" height="100%" background-color="#171919"
      scroll width="100%" height="100%"
        column padding=22 gap=18
          text "Aperture Log" role="heading" aria-level=1 font-size=36 color="#ff8151"
          match photo
            case some(p)
              image p.path width="100%" height=310 object-fit="contain" alt="Your latest photograph" testId="photo-preview"
              input value=caption input=edit aria-label="Photo caption" placeholder="Caption this frame" testId="caption" font-size=18 padding=12
            case none
              column height=310 align-items="center" justify-content="center" background-color="#282c2b"
                text "No photograph yet" color="#ddd6c7" testId="empty"
          button press=take disabled=pending(photo) buttonStyle="filled" testId="shutter"
            text (pending(photo) ? "Opening camera…" : "Take photograph")
          if issue == "NotAllowedError"
            text "Allow camera access in Settings to take a photograph." color="#ffc09e"
          if issue != "" and issue != "AbortError" and issue != "NotAllowedError"
            text "Camera unavailable. Try again." color="#ffc09e"
